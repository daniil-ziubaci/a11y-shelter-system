{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", ".wrangler", "scripts/data"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["astro/client", "@astrojs/cloudflare/types.d.ts"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
