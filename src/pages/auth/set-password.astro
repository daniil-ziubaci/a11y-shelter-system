---
import AuthPage from "@/components/panel/AuthPage.astro";
import PanelLayout from "@/layouts/PanelLayout.astro";
import { cardClass, errorClass, fieldClass, hintClass, labelClass, primaryButtonClass } from "@/lib/formClasses";
import { isPost, readForm } from "@/lib/panel";

if (!Astro.locals.claims) {
  return Astro.redirect("/login", 303);
}
let error: string | null = null;
if (isPost(Astro)) {
  const form = await readForm(Astro);
  const password = form?.get("password");
  const confirm = form?.get("confirm");
  if (typeof password !== "string" || typeof confirm !== "string") {
    error = "Введите пароль и повторите его.";
  } else if (password.length < 12) {
    error = "Пароль должен быть не короче 12 символов.";
  } else if (password !== confirm) {
    error = "Пароли не совпадают.";
  } else {
    const { error: updateError } = await Astro.locals.supabase.auth.updateUser({ password });
    if (!updateError) {
      return Astro.redirect("/volunteer/needs", 303);
    }
    error = "Не удалось сохранить пароль. Попробуйте другой пароль.";
  }
}
const { data: shelter } = await Astro.locals.supabase.from("shelter").select("name").maybeSingle();
---

<PanelLayout title="Задайте пароль">
  <AuthPage title="Задайте пароль" shelterName={shelter?.name}>
    <form method="post" action="/auth/set-password" class={cardClass}>
      <p role="alert" class={errorClass}>{error}</p>
      <div class="flex flex-col gap-1">
        <label for="password" class={labelClass}>Новый пароль</label>
        <p id="password-hint" class={hintClass}>Не короче 12 символов.</p>
        <input id="password" name="password" type="password" autocomplete="new-password" aria-describedby="password-hint" minlength="12" required class={fieldClass} />
      </div>
      <div class="flex flex-col gap-1">
        <label for="confirm" class={labelClass}>Повторите пароль</label>
        <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="12" required class={fieldClass} />
      </div>
      <button type="submit" class={primaryButtonClass} data-pending="Сохраняем…">Сохранить пароль</button>
    </form>
  </AuthPage>
</PanelLayout>
