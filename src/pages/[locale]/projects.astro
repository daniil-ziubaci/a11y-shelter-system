---
import ContentLanguageNote from "@/components/public/ContentLanguageNote.astro";
import ProjectDescription from "@/components/public/ProjectDescription.astro";
import ShelterLayout from "@/layouts/ShelterLayout.astro";
import { formatLongDate, getTranslator } from "@/lib/i18n";
import { localizeProject } from "@/lib/localizeProject";
import { contentLanguageOf, loadPublicPage } from "@/lib/page";
import { PROJECT_STATUS_COMPLETED, PROJECT_STATUS_ONGOING } from "@/lib/projectStages";
import { getPublicClient, publicPhotoUrl } from "@/lib/supabase";

const page = await loadPublicPage(Astro);
if (page instanceof Response) return page;
const { locale, shelter } = page;

const t = getTranslator(locale, "Projects");
const contentLanguage = contentLanguageOf(shelter);
const { data, error } = await getPublicClient()
  .from("projects")
  .select(
    "id, title, description, status, completed_at, is_pinned, help_kinds, photo_path, photo_alt, progress_total, progress_done, progress_unit, translations",
  )
  .eq("is_archived", false)
  .order("completed_at", { ascending: false, nullsFirst: false })
  .order("created_at", { ascending: false });

const projects = (data ?? []).map((project) => localizeProject(project, locale));
const anyTranslated = projects.some((project) => Object.values(project.translated).some(Boolean));
const ongoing = projects
  .filter((project) => project.status === PROJECT_STATUS_ONGOING)
  .sort((a, b) => Number(b.is_pinned) - Number(a.is_pinned));
const completed = projects.filter((project) => project.status === PROJECT_STATUS_COMPLETED);
const groups = [
  { id: "ongoing-heading", heading: t("ongoingHeading"), items: ongoing, empty: t("noOngoing") },
  { id: "completed-heading", heading: t("completedHeading"), items: completed, empty: null },
];
const languageOf = (translated: boolean) => (translated ? locale : contentLanguage);
---

<ShelterLayout
  locale={locale}
  shelter={shelter}
  title={t("title", { shelter: shelter.name })}
  description={t("description", { shelter: shelter.name })}
  path="/projects"
>
  <main class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-4 pt-4 pb-10">
    {
      error ? (
        <p role="alert">{t("loadError")}</p>
      ) : (
        <>
          <h1 class="text-center text-3xl font-bold">{t("heading", { shelter: shelter.name })}</h1>
          <p class="-mt-3 text-center text-lg text-(--muted)">{t("intro")}</p>
          {projects.length > 0 && <ContentLanguageNote locale={locale} language={contentLanguage} translated={anyTranslated} />}
          {projects.length === 0 ? (
            <p>{t("none")}</p>
          ) : (
            groups
              .filter((group) => group.items.length > 0 || group.empty)
              .map((group) => (
                <section aria-labelledby={group.id} class="flex flex-col gap-4">
                  <h2 id={group.id} class="text-2xl font-bold">
                    {group.heading}
                  </h2>
                  {group.items.length === 0 ? (
                    <p>{group.empty}</p>
                  ) : (
                    <ul class="flex flex-col gap-6">
                      {group.items.map((project) => (
                        <li
                          class:list={[
                            "flex flex-col gap-3 rounded-2xl border border-(--border-strong) p-5 shadow-sm sm:flex-row sm:gap-6",
                            project.is_pinned ? "bg-(--accent-soft)" : "bg-(--surface)",
                          ]}
                        >
                          {project.photo_path && project.photo_alt && (
                            <div class="relative aspect-4/3 w-full overflow-hidden rounded-xl bg-(--hover) sm:w-2/5 sm:shrink-0 sm:self-start">
                              <img
                                src={publicPhotoUrl(project.photo_path)}
                                alt={project.photo_alt}
                                width="1600"
                                height="1200"
                                loading="lazy"
                                decoding="async"
                                class="absolute inset-0 size-full object-cover"
                              />
                            </div>
                          )}
                          <div class="flex flex-1 flex-col gap-3">
                            {project.is_pinned && (
                              <p class="inline-flex items-center gap-2 self-start rounded-full border border-(--accent) bg-(--surface) px-3 py-1 text-sm font-medium text-(--accent)">
                                <span aria-hidden="true" class="size-1.5 rounded-full bg-current" />
                                {t("pinnedBadge")}
                              </p>
                            )}
                            <h3 lang={languageOf(project.translated.title)} class="text-2xl leading-tight font-bold sm:text-3xl">
                              {project.title}
                            </h3>
                            <ProjectDescription text={project.description} language={languageOf(project.translated.description)} />
                            {project.status === PROJECT_STATUS_ONGOING &&
                              project.progress_total !== null &&
                              project.progress_done !== null &&
                              project.progress_unit && (
                                <div class="flex flex-col gap-2">
                                  <p class="text-lg font-semibold">
                                    {t("progressText", {
                                      done: project.progress_done,
                                      total: project.progress_total,
                                      unit: project.progress_unit,
                                      left: project.progress_total - project.progress_done,
                                    })}
                                  </p>
                                  <div aria-hidden="true" class="h-3 w-full overflow-hidden rounded-full border border-(--border-strong) bg-(--hover)">
                                    <div
                                      class="h-full bg-(--accent)"
                                      style={`width: ${Math.round((project.progress_done / project.progress_total) * 100)}%`}
                                    />
                                  </div>
                                </div>
                              )}
                            {project.status === PROJECT_STATUS_COMPLETED && project.progress_total !== null && project.progress_unit && (
                              <p class="border-l-4 border-(--accent) pl-4">
                                <span class="font-bold">
                                  <span aria-hidden="true">✓ </span>
                                  {t("goalAchievedLabel")}
                                </span>{" "}
                                {project.progress_total} {project.progress_unit}
                              </p>
                            )}
                            {project.status === PROJECT_STATUS_ONGOING && (
                              <ul aria-label={t("helpKindsLabel")} class="flex flex-wrap gap-2">
                                {project.help_kinds.map((kind) => (
                                  <li class="rounded-full border border-(--accent) bg-(--accent-soft) px-3 py-1.5 text-sm font-semibold text-(--accent)">
                                    {t(`helpKinds.${kind}`)}
                                  </li>
                                ))}
                              </ul>
                            )}
                            {project.completed_at && (
                              <p class="text-(--muted)">{t("completedOn", { date: formatLongDate(locale, project.completed_at) })}</p>
                            )}
                            {project.status === PROJECT_STATUS_ONGOING && (
                              <a
                                href="#footer-contact-heading"
                                aria-label={t(project.is_pinned ? "supportProgramLabel" : "helpLabel", { name: project.title })}
                                class="mt-auto flex min-h-11 w-full items-center justify-center rounded-full bg-(--accent) px-5 py-2 text-center text-lg font-semibold text-(--accent-contrast) sm:inline-flex sm:w-auto sm:self-start"
                              >
                                {t(project.is_pinned ? "supportProgram" : "help")}
                              </a>
                            )}
                          </div>
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
              ))
          )}
        </>
      )
    }
  </main>
</ShelterLayout>
