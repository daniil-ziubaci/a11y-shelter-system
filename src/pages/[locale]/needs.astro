---
import ContentLanguageNote from "@/components/public/ContentLanguageNote.astro";
import Rich from "@/components/public/Rich.astro";
import ShelterLayout from "@/layouts/ShelterLayout.astro";
import { formatNumber, getTranslator } from "@/lib/i18n";
import { localizeItem } from "@/lib/localizeItem";
import { getCategoryKey, NEED_CATEGORIES } from "@/lib/needCategories";
import { getUnitKey } from "@/lib/needUnits";
import { contentLanguageOf, loadPublicPage } from "@/lib/page";
import { NEEDS_PAGE_SIZE, parseShown } from "@/lib/parsePage";
import { getPublicClient } from "@/lib/supabase";

const page = await loadPublicPage(Astro);
if (page instanceof Response) return page;
const { locale, shelter } = page;

const params = Astro.url.searchParams;
const urgentOnly = params.get("urgent") === "1";
const rawCategory = params.get("category") ?? "";
const category = !urgentOnly && NEED_CATEGORIES.includes(rawCategory) ? rawCategory : undefined;
const shown = parseShown(params.get("shown") ?? undefined);
const t = getTranslator(locale, "Needs");
const contentLanguage = contentLanguageOf(shelter);
const supabase = getPublicClient();

function buildQuery(head: boolean) {
  let query = supabase
    .from("purchase_items")
    .select("id, name, category, unit, remaining, is_urgent, note, translations", { count: "exact", head })
    .gt("remaining", 0);
  if (category) query = query.eq("category", category);
  if (urgentOnly) query = query.eq("is_urgent", true);
  return query;
}

const [counted, loaded] = await Promise.all([
  buildQuery(true),
  buildQuery(false).order("is_urgent", { ascending: false }).order("created_at", { ascending: false }).order("id").range(0, shown - 1),
]);
const failed = Boolean(counted.error || loaded.error);
const total = counted.count ?? 0;
const items = (loaded.data ?? []).map((item) => localizeItem(item, locale));
const hasHands = Boolean(shelter.contact_phone);
const hasMoney = Boolean(shelter.donation_text || shelter.payment_url || shelter.paypal_email);
const donationLanguage = shelter.translated.donationText ? locale : contentLanguage;

function buildHref(nextCategory?: string, nextShown = NEEDS_PAGE_SIZE, nextUrgent = false) {
  const query = new URLSearchParams();
  if (nextUrgent) query.set("urgent", "1");
  else if (nextCategory) query.set("category", nextCategory);
  if (nextShown > NEEDS_PAGE_SIZE) query.set("shown", String(nextShown));
  const text = query.toString();
  return `/${locale}/needs${text ? `?${text}` : ""}`;
}

const filterLink =
  "inline-flex min-h-11 items-center rounded-full border border-transparent bg-(--hover) px-3 py-2 transition-colors duration-200 hover:border-(--accent) motion-reduce:transition-none aria-current:border-(--accent) aria-current:bg-(--accent) aria-current:font-semibold aria-current:text-(--accent-contrast)";
const inlineLink = "font-semibold text-(--accent) underline underline-offset-2";
const blockButton =
  "inline-flex min-h-14 max-w-full items-center justify-start self-start rounded-full bg-(--accent) px-6 py-3 text-left text-lg font-semibold text-(--accent-contrast) hover:shadow-md";
const title = t("title", { shelter: shelter.name });
---

<ShelterLayout locale={locale} shelter={shelter} title={title} description={t("description", { shelter: shelter.name })} path="/needs">
  <main class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-4 pt-4 pb-10">
    {
      failed ? (
        <p role="alert">{t("loadError")}</p>
      ) : (
        <>
          <h1 class="text-center text-3xl font-bold">{t("heading")}</h1>
          <p class="-mt-3 text-center text-lg text-(--muted)">
            <Rich
              text={t("intro")}
              links={{ treatment: `/${locale}/catalog?mode=treatment`, projects: `/${locale}/projects` }}
            />
          </p>
          {(hasHands || hasMoney) && (
            <p class="-mt-2 text-center text-lg">
              {t("helpWaysIntro")}{" "}
              {hasHands && (
                <a href="#help-hands" class={inlineLink}>
                  {t("helpHandsLink")}
                </a>
              )}
              {hasHands && hasMoney && ", "}
              {hasMoney && (
                <a href="#help-money" class={inlineLink}>
                  {t("helpMoneyLink")}
                </a>
              )}
            </p>
          )}
          <nav aria-label={t("filtersLabel")}>
            <div class="flex flex-wrap gap-2">
              <a href={buildHref()} aria-current={category === undefined && !urgentOnly ? "true" : undefined} class={filterLink}>
                {t("all")}
              </a>
              <a href={buildHref(undefined, NEEDS_PAGE_SIZE, true)} aria-current={urgentOnly ? "true" : undefined} class={filterLink}>
                {t("urgentFilter")}
              </a>
              {NEED_CATEGORIES.map((name) => {
                const key = getCategoryKey(name);
                return (
                  <a href={buildHref(name)} aria-current={category === name ? "true" : undefined} class={filterLink}>
                    {key ? t(`categories.${key}`) : name}
                  </a>
                );
              })}
            </div>
          </nav>
          {total > 0 && (
            <p role="status" class="-mb-1 text-(--muted)">
              {total > items.length ? t("shown", { to: items.length, total }) : t("found", { count: total })}
            </p>
          )}
          {total > 0 && <ContentLanguageNote locale={locale} language={contentLanguage} translated={items.some((item) => item.translated)} />}
          {items.length === 0 ? (
            <p>{urgentOnly ? t("emptyUrgent") : category ? t("emptyCategory") : t("empty")}</p>
          ) : (
            <ul role="list" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((item, index) => {
                const categoryKey = getCategoryKey(item.category);
                const unitKey = getUnitKey(item.unit);
                return (
                  <li
                    id={`need-${index}`}
                    class:list={[
                      "group relative flex min-w-0 flex-col gap-3 rounded-2xl bg-(--surface) p-4 shadow-md transition duration-300 ease-out focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-(--focus) hover:shadow-2xl motion-safe:hover:-translate-y-1.5",
                      item.is_urgent ? "border-urgent border-(--danger)" : "border border-(--border-strong)",
                    ]}
                  >
                    <div class="flex min-w-0 flex-col gap-1">
                      <div class="flex items-start justify-between gap-2">
                        <h2 lang={item.translated ? locale : contentLanguage} class="min-w-0 text-lg font-bold wrap-anywhere">
                          {item.name}
                        </h2>
                        {item.is_urgent && (
                          <p class="shrink-0 rounded-full bg-(--danger-soft) px-3 py-0.5 text-sm font-semibold text-(--danger)">
                            <span aria-hidden="true">🔥 </span>
                            {t("urgent")}
                          </p>
                        )}
                      </div>
                      <p class="text-(--muted)">{categoryKey ? t(`categories.${categoryKey}`) : item.category}</p>
                      {item.note && (
                        <p lang={item.noteTranslated ? locale : contentLanguage} class="wrap-anywhere">
                          {item.note}
                        </p>
                      )}
                    </div>
                    <div class="mt-auto flex flex-col gap-3">
                      <p class="text-lg font-bold">
                        {t("remaining", {
                          amount: formatNumber(locale, item.remaining),
                          unit: unitKey ? t(`units.${unitKey}`) : item.unit,
                        })}
                      </p>
                      <a
                        href="#footer-contact-heading"
                        aria-label={t("helpLabel", { name: item.name })}
                        class="flex min-h-14 items-center justify-center self-start rounded-full bg-(--accent) px-6 py-3 text-lg font-semibold text-(--accent-contrast) sm:after:absolute sm:after:inset-0"
                      >
                        {t("help")}
                      </a>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
          {total > items.length && (
            <div class="flex justify-center">
              <a
                href={`${buildHref(category, shown + NEEDS_PAGE_SIZE, urgentOnly)}#need-${shown}`}
                class="inline-flex min-h-11 items-center rounded-full border border-(--accent) px-5 text-lg font-semibold text-(--accent) transition-colors duration-200 hover:bg-(--hover) motion-reduce:transition-none"
              >
                {t("showMore")}
              </a>
            </div>
          )}
          {shelter.contact_phone && (
            <section id="help-hands" aria-labelledby="hands-heading" class="flex flex-col gap-4 rounded-2xl border border-(--border-strong) bg-(--surface) p-6 shadow-md">
              <h2 id="hands-heading" class="text-xl font-bold">
                {t("handsHeading")}
              </h2>
              <p>{t("handsText")}</p>
              <a href={`tel:${shelter.contact_phone.replace(/[^\d+]/g, "")}`} class={blockButton}>
                {t("handsCall", { phone: shelter.contact_phone })}
              </a>
            </section>
          )}
          {hasMoney && (
            <section id="help-money" aria-labelledby="donation-heading" class="flex flex-col gap-4 rounded-2xl border border-(--border-strong) bg-(--surface) p-6 shadow-md">
              <h2 id="donation-heading" class="text-xl font-bold">
                {t("donationHeading")}
              </h2>
              {shelter.donation_text && (
                <p lang={donationLanguage} class="whitespace-pre-line">
                  {shelter.donation_text}
                </p>
              )}
              {shelter.payment_url && (
                <a href={shelter.payment_url} target="_blank" rel="noopener noreferrer" class={blockButton}>
                  {t("donationPay")}
                  <span class="sr-only"> {t("newTab")}</span>
                </a>
              )}
              {shelter.paypal_email && (
                <p>
                  {t("donationPaypal")} <span class="font-semibold break-all">{shelter.paypal_email}</span>
                </p>
              )}
            </section>
          )}
        </>
      )
    }
  </main>
</ShelterLayout>
