---
import { ProjectForm } from "@/islands/ProjectForm";
import PanelLayout from "@/layouts/PanelLayout.astro";
import { isPost, isVolunteer, NOT_A_VOLUNTEER, readForm } from "@/lib/panel";
import { DEFAULT_PROJECT_HELP_KINDS } from "@/lib/projectHelpKinds";
import { saveProject } from "@/lib/projectSave";

const volunteer = await isVolunteer(Astro.locals.supabase, Astro.locals.claims?.sub);
let error: string | null = null;
let values: Record<string, string> | null = null;
if (volunteer && isPost(Astro)) {
  const form = await readForm(Astro);
  if (form) {
    const result = await saveProject(Astro, form, null);
    if (result.ok) return Astro.redirect("/volunteer/projects", 303);
    error = result.error;
    values = result.values;
  }
}
const initial = {
  title: values?.title ?? "",
  description: values?.description ?? "",
  photoAlt: values?.photoAlt ?? "",
  helpKinds: values ? (values.help_kinds ?? "").split(",") : [...DEFAULT_PROJECT_HELP_KINDS],
  progressTotal: values?.progressTotal ?? "",
  progressDone: values?.progressDone ?? "",
  progressUnit: values?.progressUnit ?? "",
};
---

<PanelLayout title="Добавить проект">
  <main class="mx-auto flex w-full max-w-5xl flex-col gap-4 px-4 pt-1 pb-8">
    <h1 class="text-3xl font-bold wrap-break-word sm:mx-auto sm:w-half-gap sm:text-center">Добавить проект</h1>
    {volunteer ? <ProjectForm client:load action="/volunteer/projects/new" mode="new" initial={initial} error={error} /> : <p role="alert">{NOT_A_VOLUNTEER}</p>}
  </main>
</PanelLayout>
