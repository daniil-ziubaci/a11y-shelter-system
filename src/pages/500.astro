---
import Base from "@/layouts/Base.astro";
import { getTranslator, toLocale } from "@/lib/i18n";

const locale = toLocale(Astro.url.pathname.split("/")[1]);
const t = getTranslator(locale, "Error");
---

<Base title={t("title")} locale={locale} noindex>
  <main class="mx-auto flex w-full max-w-3xl flex-col items-center gap-4 p-8 text-center">
    <h1 class="text-3xl font-bold">{t("heading")}</h1>
    <p role="alert">{t("text")}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={Astro.url.pathname} class="inline-flex min-h-11 items-center justify-center rounded-full bg-(--accent) px-5 py-2 font-semibold text-(--accent-contrast) hover:shadow-md">
        {t("retry")}
      </a>
      <a href={`/${locale}`} class="inline-flex min-h-11 items-center justify-center rounded-full border border-(--border) bg-(--surface) px-5 py-2 font-semibold text-(--accent) hover:shadow-md">
        {t("home")}
      </a>
    </div>
  </main>
</Base>
