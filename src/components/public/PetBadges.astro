---
import { getTranslator, type Locale } from "@/lib/i18n";
import { getStatusKey } from "@/lib/petLabels";
import { PET_STATUS_LOOKING, PET_STATUS_TREATMENT } from "@/lib/petStatuses";

interface Props {
  locale: Locale;
  status: string;
  needsTreatmentSince: string | null;
}

const { locale, status, needsTreatmentSince } = Astro.props;
const t = getTranslator(locale, "Pet");
const statusKey = getStatusKey(status);
const isInTreatment = status === PET_STATUS_TREATMENT;
---

{
  needsTreatmentSince && (
    <p class="inline-flex items-center gap-1.5 rounded-full bg-(--danger-soft) px-2.5 py-0.5 text-sm font-medium text-(--danger) shadow-sm ring-1 ring-(--border)">
      <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-(--danger)" />
      {t("needsTreatmentBadge")}
    </p>
  )
}
{
  status !== PET_STATUS_LOOKING && (
    <p
      class:list={[
        "inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-sm font-medium shadow-sm ring-1",
        isInTreatment ? "bg-(--hover) text-(--muted) ring-(--border-strong)" : "bg-(--pending-soft) text-(--pending) ring-(--border)",
      ]}
    >
      <span aria-hidden="true" class:list={["size-1.5 shrink-0 rounded-full", isInTreatment ? "bg-(--muted)" : "bg-(--pending)"]} />
      {statusKey ? t(`status.${statusKey}`) : status}
    </p>
  )
}
