// Cloudflare Workers configuration of the Astro site (@astrojs/cloudflare).
// Variables and secrets live only in the dashboard as Runtime variables
// (keep_vars keeps them on deploy); the build needs none.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a11y-shelter-system",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  // 02:00 UTC nightly translation, 14:00 UTC a request to the database so
  // Supabase Free does not pause the project. src/worker.ts maps each
  // schedule to its route.
  "triggers": {
    "crons": ["0 2 * * *", "0 14 * * *"]
  }
}
