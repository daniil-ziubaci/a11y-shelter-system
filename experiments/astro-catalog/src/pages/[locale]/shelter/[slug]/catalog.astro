---
import ShelterLayout from "../../../../components/ShelterLayout.astro";
import PetCard from "../../../../components/PetCard.astro";
import { getT, LOCALES } from "../../../../lib/i18n";
import { getShelter } from "../../../../lib/getShelter";
import { getSupabase } from "../../../../lib/supabase";
import { toPet } from "@/lib/toPet";
import { buildAlternates, getShelterPreviewImage } from "@/lib/seo";
import { getSizeFromKey } from "@/lib/petSizes";
import { PET_STATUS_TREATMENT, PUBLIC_PET_STATUSES } from "@/lib/petStatuses";
import { CATALOG_PAGE_SIZE, parsePage } from "@/lib/parsePage";
import { cardCopyOf } from "@/lib/photoUrls";

const { locale, slug } = Astro.params as { locale: string; slug: string };
if (!LOCALES.includes(locale as never)) return new Response(null, { status: 404 });
const sp = Astro.url.searchParams;
const get = (k: string) => sp.get(k) ?? undefined;
const species = get("species"), mode = get("mode"), group = get("group"), q = get("q");
const rawSex = get("sex"), rawAge = get("age"), rawSize = get("size"), rawPage = get("page");
const isTreatment = mode === "treatment";
const sex = isTreatment ? undefined : rawSex;
const age = isTreatment ? undefined : rawAge;
const size = isTreatment ? undefined : rawSize;
const isBlocked = isTreatment && group === "blocked";
const shelter = await getShelter(slug, locale);
if (!shelter) return new Response(null, { status: 404 });
const t = getT(locale, "Catalog");
const search = (q ?? "").trim().slice(0, 50);
const requestedPage = parsePage(rawPage);

const twelveMonthsAgo = new Date();
twelveMonthsAgo.setMonth(twelveMonthsAgo.getMonth() - 12);
const sevenYearsAgo = new Date();
sevenYearsAgo.setMonth(sevenYearsAgo.getMonth() - 84);
const supabase = getSupabase();

function buildQuery(head: boolean) {
  let query = supabase.from("pets").select("*", { count: "exact", head })
    .eq("shelter_id", shelter!.id).in("status", PUBLIC_PET_STATUSES);
  if (isBlocked) query = query.eq("status", PET_STATUS_TREATMENT).order("status_changed_at", { ascending: true }).order("name");
  else if (isTreatment) query = query.not("needs_treatment_since", "is", null).order("needs_treatment_since", { ascending: true }).order("name");
  else query = query.order("status_rank").order("created_at", { ascending: false }).order("name");
  if (search) query = query.ilike("name_search", `%${search.replace(/[\\%_]/g, "\\$&")}%`);
  if (species === "cat") query = query.eq("species", "кошка");
  if (species === "dog") query = query.eq("species", "собака");
  if (sex === "male") query = query.eq("sex", "мальчик");
  if (sex === "female") query = query.eq("sex", "девочка");
  if (age === "young") query = query.gt("birth_date", twelveMonthsAgo.toISOString().slice(0, 10));
  if (age === "adult") query = query.lte("birth_date", twelveMonthsAgo.toISOString().slice(0, 10)).gt("birth_date", sevenYearsAgo.toISOString().slice(0, 10));
  if (age === "senior") query = query.lte("birth_date", sevenYearsAgo.toISOString().slice(0, 10));
  const sizeValue = species === "dog" && size ? getSizeFromKey(size) : undefined;
  if (sizeValue) query = query.eq("size", sizeValue);
  return query;
}
const { count, error: countError } = await buildQuery(true);
if (countError) throw new Error("Не удалось загрузить питомцев из базы.");
const total = count ?? 0;
const lastPage = Math.max(1, Math.ceil(total / CATALOG_PAGE_SIZE));
if (requestedPage > lastPage) {
  const keep = new URLSearchParams(Object.entries({ species, sex: rawSex, age: rawAge, size: rawSize, mode, group, q }).filter(([, v]) => v) as [string, string][]);
  if (lastPage > 1) keep.set("page", String(lastPage));
  const qs = keep.toString();
  return Astro.redirect(`/${locale}/shelter/${slug}/catalog${qs ? "?" + qs : ""}`, 307);
}
const from = (requestedPage - 1) * CATALOG_PAGE_SIZE;
const { data, error } = await buildQuery(false).range(from, from + CATALOG_PAGE_SIZE - 1);
if (error) throw new Error("Не удалось загрузить питомцев из базы.");
const pets = (data ?? []).map((row) => toPet(row, locale));

function buildHref(newSpecies?: string, newSex?: string, newAge?: string, newSize: string | null | undefined = size) {
  const params = new URLSearchParams();
  if (newSpecies) params.set("species", newSpecies);
  if (newSex) params.set("sex", newSex);
  if (newAge) params.set("age", newAge);
  if (newSize && newSpecies === "dog") params.set("size", newSize);
  if (isTreatment) params.set("mode", "treatment");
  if (isBlocked) params.set("group", "blocked");
  if (search) params.set("q", search);
  const qs = params.toString();
  return `/${locale}/shelter/${slug}/catalog` + (qs ? "?" + qs : "");
}
function buildPageHref(page: number) {
  const href = buildHref(species, sex, age);
  return page === 1 ? href : href + (href.includes("?") ? "&" : "?") + "page=" + page;
}
const pageNumbers = Array.from({ length: lastPage }, (_, i) => i + 1).filter((n) => n === 1 || n === lastPage || Math.abs(n - requestedPage) <= 1);

const filterLink = "inline-flex min-h-11 items-center rounded-full border border-transparent bg-(--hover) px-3 py-2 transition-colors duration-200 hover:border-(--accent) motion-reduce:transition-none aria-current:border-(--accent) aria-current:bg-(--accent) aria-current:font-semibold aria-current:text-(--accent-contrast)";
const pageLink = `${filterLink} aria-[current=page]:border-(--accent) aria-[current=page]:bg-(--accent) aria-[current=page]:font-semibold aria-[current=page]:text-(--accent-contrast)`;
const legendClass = "mb-2 cursor-default text-sm font-semibold text-(--muted) sm:float-left sm:mb-0 sm:w-24 sm:pt-2.5 sm:text-base";
const searchPart = (search ? `&q=${encodeURIComponent(search)}` : "") + (species === "cat" || species === "dog" ? `&species=${species}` : "");
const treatmentHelpHref = `/${locale}/shelter/${slug}/catalog?mode=treatment${searchPart}`;
const treatmentBlockedHref = `/${locale}/shelter/${slug}/catalog?mode=treatment&group=blocked${searchPart}`;

// Metadata, as generateMetadata in the Next page.
const prefix = isBlocked ? "treatmentBlocked" : "treatment";
const query = isBlocked ? "?mode=treatment&group=blocked" : isTreatment ? "?mode=treatment" : "";
const pageQuery = requestedPage > 1 ? `${query ? "&" : "?"}page=${requestedPage}` : "";
const baseTitle = t(isTreatment ? `${prefix}Title` : "title", { shelter: shelter.name });
const title = requestedPage > 1 ? t("titleWithPage", { title: baseTitle, page: requestedPage }) : baseTitle;
const description = t(isTreatment ? `${prefix}Description` : "description", { shelter: shelter.name });
const path = `/shelter/${slug}/catalog${query}${pageQuery}`;
const site = process.env.SITE_URL!;
const alternates = buildAlternates(locale, path);
const image = getShelterPreviewImage(shelter);
const ogLocale = { ru: "ru_RU", ro: "ro_RO", en: "en_US" }[locale];
const intro = isTreatment ? t(isBlocked ? "treatmentIntroBlocked" : "treatmentIntroHelp", {
  link: (chunks: string) => `<a href="#footer-contact-heading" class="font-semibold text-(--accent) underline underline-offset-2">${chunks}</a>`,
}) : "";
const searchString = Astro.url.search;
---
<ShelterLayout locale={locale} slug={slug} shelter={shelter} path={`/shelter/${slug}/catalog`} search={searchString} isTreatment={isTreatment}>
  <Fragment slot="head">
    {pets.slice(0, 3).map((pet) => <link rel="preload" as="image" href={cardCopyOf(pet.photo.url)} />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    {q?.trim() && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={site + alternates.canonical} />
    {Object.entries(alternates.languages).map(([code, href]) => <link rel="alternate" hreflang={code} href={site + href} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}/${locale}${path}`} />
    <meta property="og:site_name" content={shelter.name} />
    <meta property="og:locale" content={ogLocale} />
    {image && <><meta property="og:image" content={image.url} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={image.alt} /><meta property="og:image:type" content="image/jpeg" /></>}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <><meta name="twitter:image" content={image.url} /><meta name="twitter:image:alt" content={image.alt} /></>}
  </Fragment>
  <main class="w-full flex flex-col gap-6 px-4 pb-10 pt-4 max-w-5xl mx-auto">
    <h1 class="text-3xl font-bold text-center">{isBlocked ? t("treatmentBlockedHeading") : isTreatment ? t("treatmentHeading") : t("heading", { shelter: shelter.name })}</h1>
    {!isBlocked && !isTreatment && <p class="-mt-3 text-center text-lg text-(--muted)">{t("subheading")}</p>}
    {isTreatment && <p class="-mt-3 text-center text-lg text-(--muted)" set:html={intro} />}
    <div class="flex flex-col gap-4 rounded-2xl border border-(--border) bg-(--surface) p-4 shadow-sm">
      <form role="search" class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-0">
        <label for="catalog-search" class="text-sm font-semibold text-(--muted) sm:w-24 sm:text-base">{t("searchLabel")}</label>
        <div class="flex min-w-0 max-w-95 flex-1 gap-2">
          <input id="catalog-search" type="search" name="q" value={search} maxlength="50"
            class="min-h-10 min-w-0 flex-1 rounded-full border border-(--border-strong) bg-(--surface) px-4 focus-visible:outline-(--accent)! focus-visible:outline-offset-0!" />
          <button type="submit" class="min-h-10 cursor-pointer rounded-full bg-(--accent) px-4 text-(--accent-contrast) hover:shadow-md">{t("searchButton")}</button>
        </div>
        {species && <input type="hidden" name="species" value={species} />}
        {sex && <input type="hidden" name="sex" value={sex} />}
        {age && <input type="hidden" name="age" value={age} />}
        {species === "dog" && size && <input type="hidden" name="size" value={size} />}
        {isTreatment && <input type="hidden" name="mode" value="treatment" />}
        {isBlocked && <input type="hidden" name="group" value="blocked" />}
      </form>
      <nav aria-label={t("filtersLabel")}>
        <div class="flex flex-col gap-4">
          <fieldset class="min-w-0">
            <legend class={legendClass}>{t("species")}</legend>
            <div class="flex flex-wrap gap-2">
              <a href={buildHref(undefined, sex, age)} aria-current={species === undefined ? "true" : undefined} class={filterLink}>{t("all")}</a>
              <a href={buildHref("dog", sex, age)} aria-current={species === "dog" ? "true" : undefined} class={filterLink}>{t("dogs")}</a>
              <a href={buildHref("cat", sex, age)} aria-current={species === "cat" ? "true" : undefined} class={filterLink}>{t("cats")}</a>
            </div>
          </fieldset>
          {isTreatment && (
            <fieldset class="min-w-0">
              <legend class={legendClass}>{t("treatmentLegend")}</legend>
              <div class="flex flex-wrap gap-2">
                <a href={treatmentHelpHref} aria-current={!isBlocked ? "true" : undefined} class={filterLink}>{t("treatmentGroupHelp")}</a>
                <a href={treatmentBlockedHref} aria-current={isBlocked ? "true" : undefined} class={filterLink}>{t("treatmentGroupBlocked")}</a>
              </div>
            </fieldset>
          )}
          {!isTreatment && (
            <>
              <fieldset class="min-w-0">
                <legend class={legendClass}>{t("sex")}</legend>
                <div class="flex flex-wrap gap-2">
                  <a href={buildHref(species, undefined, age)} aria-current={sex === undefined ? "true" : undefined} class={filterLink}>{t("all")}</a>
                  <a href={buildHref(species, "male", age)} aria-current={sex === "male" ? "true" : undefined} class={filterLink}>{t("males")}</a>
                  <a href={buildHref(species, "female", age)} aria-current={sex === "female" ? "true" : undefined} class={filterLink}>{t("females")}</a>
                </div>
              </fieldset>
              <fieldset class="min-w-0">
                <legend class={legendClass}>{t("age")}</legend>
                <div class="flex flex-wrap gap-2">
                  <a href={buildHref(species, sex, undefined)} aria-current={age === undefined ? "true" : undefined} class={filterLink}>{t("all")}</a>
                  <a href={buildHref(species, sex, "young")} aria-current={age === "young" ? "true" : undefined} class={filterLink}>{t("young")}</a>
                  <a href={buildHref(species, sex, "adult")} aria-current={age === "adult" ? "true" : undefined} class={filterLink}>{t("adult")}</a>
                  <a href={buildHref(species, sex, "senior")} aria-current={age === "senior" ? "true" : undefined} class={filterLink}>{t("senior")}</a>
                </div>
              </fieldset>
              {species === "dog" && (
                <fieldset class="min-w-0">
                  <legend class={legendClass}>{t("size")}</legend>
                  <div class="flex flex-wrap gap-2">
                    <a href={buildHref(species, sex, age, null)} aria-current={!size ? "true" : undefined} class={filterLink}>{t("all")}</a>
                    <a href={buildHref(species, sex, age, "small")} aria-current={size === "small" ? "true" : undefined} class={filterLink}>{t("sizeSmall")}</a>
                    <a href={buildHref(species, sex, age, "medium")} aria-current={size === "medium" ? "true" : undefined} class={filterLink}>{t("sizeMedium")}</a>
                    <a href={buildHref(species, sex, age, "large")} aria-current={size === "large" ? "true" : undefined} class={filterLink}>{t("sizeLarge")}</a>
                  </div>
                </fieldset>
              )}
            </>
          )}
        </div>
      </nav>
    </div>
    <p role="status" class="-mb-1 text-(--muted)">
      {total === 0 ? t("none") : total <= CATALOG_PAGE_SIZE ? t("found", { count: total }) : t("shown", { from: from + 1, to: from + pets.length, total })}
    </p>
    {pets.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {pets.map((pet, index) => <PetCard pet={pet} slug={slug} locale={locale} eager={index < 3} />)}
      </div>
    )}
    {lastPage > 1 && (
      <nav aria-label={t("paginationLabel")} class="flex flex-wrap items-center justify-center gap-2">
        {requestedPage > 1 && <a href={buildPageHref(requestedPage - 1)} class={pageLink}>{t("previousPage")}</a>}
        {pageNumbers.map((n, i) => (
          <>
            {i > 0 && n - pageNumbers[i - 1] > 1 && <span aria-hidden="true">…</span>}
            <a href={buildPageHref(n)} aria-current={n === requestedPage ? "page" : undefined} aria-label={t("pageLabel", { page: n })} class={pageLink}>{n}</a>
          </>
        ))}
        {requestedPage < lastPage && <a href={buildPageHref(requestedPage + 1)} class={pageLink}>{t("nextPage")}</a>}
      </nav>
    )}
  </main>
</ShelterLayout>
