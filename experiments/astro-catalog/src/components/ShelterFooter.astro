---
import { getT } from "../lib/i18n";
import { siInstagram, siFacebook, siTiktok, siViber, siTelegram } from "simple-icons";
import type { Shelter } from "../lib/getShelter";
interface Props { locale: string; slug: string; shelter: Shelter }
const { locale, slug, shelter } = Astro.props;
const t = getT(locale, "Footer");
const tNav = getT(locale, "Nav");
const tAbout = getT(locale, "About");
const hoursLanguage = shelter.translated.hours ? locale : shelter.content_language;
const legalInfoLanguage = shelter.translated.legalInfo ? locale : shelter.content_language;
const showTranslationNote = locale !== shelter.content_language;
const catalogPath = `/shelter/${slug}/catalog`;
const links = [
  { href: `/shelter/${slug}`, label: tNav("home") },
  { href: catalogPath, label: tNav("catalog") },
  { href: `/shelter/${slug}/needs`, label: tNav("needs") },
  { href: `${catalogPath}?mode=treatment`, label: tNav("treatment") },
  { href: `/shelter/${slug}/projects`, label: tNav("projects") },
  { href: `/shelter/${slug}/about`, label: tNav("about") },
];
const phone = shelter.contact_phone, email = shelter.contact_email, messenger = shelter.contact_messenger;
const networks = [
  { name: "Instagram", icon: siInstagram, color: siInstagram.hex, url: shelter.instagram_url },
  { name: "Facebook", icon: siFacebook, color: siFacebook.hex, url: shelter.facebook_url },
  { name: "TikTok", icon: siTiktok, color: siTiktok.hex, url: shelter.tiktok_url },
  { name: "Viber", icon: siViber, color: siViber.hex, url: shelter.viber_url },
  { name: "Telegram", icon: siTelegram, color: "1E84B6", url: shelter.telegram_url },
].filter((n) => n.url);
---
<footer class="mt-auto w-full bg-(--surface)">
  <div class="mx-auto grid w-full max-w-5xl gap-8 px-4 pb-8 pt-8 md:grid-cols-3 md:gap-x-12">
    <section aria-labelledby="footer-contact-heading" class="flex flex-col gap-5">
      <div class="flex flex-col gap-2">
        <h2 id="footer-contact-heading" class="text-xl font-bold">{t("contactHeading")}</h2>
        <p>{t("contactIntro")}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        {phone && (
          <a href={`tel:${phone.replace(/[^\d+]/g, "")}`}
            class="inline-flex min-h-14 max-w-full items-center justify-start rounded-full bg-(--accent) px-6 py-3 text-left text-lg font-semibold text-(--accent-contrast) hover:shadow-md">{tAbout("call", { phone })}</a>
        )}
        {messenger && (
          <a href={messenger}
            class="inline-flex min-h-14 max-w-full items-center justify-start rounded-full border-2 border-(--accent) px-6 py-3 text-left text-lg font-semibold text-(--accent) hover:bg-(--hover)"
            target="_blank" rel="noopener noreferrer">{tAbout("messenger")}<span class="sr-only"> {tAbout("newTab")}</span></a>
        )}
        {!phone && !email && !messenger && <p>{t("noContact")}</p>}
      </div>
      {phone && <p class="mt-3">{tAbout("phoneNote")}</p>}
      {email && <p class="mt-3">{tAbout("emailLine", { email })}</p>}
      {networks.length > 0 && (
        <nav aria-labelledby="footer-social-heading" class="flex flex-col gap-3 pb-1.5">
          <p id="footer-social-heading" class="font-semibold">{t("socialHeading")}</p>
          <ul class="flex flex-wrap gap-5">
            {networks.map((network) => (
              <li class="flex">
                <a href={network.url} aria-label={t("socialLink", { network: network.name })}
                  class="inline-flex size-14 items-center justify-center rounded-full transition-opacity duration-200 hover:opacity-70 motion-reduce:transition-none"
                  style={`color:#${network.color}`} target="_blank" rel="noopener noreferrer">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-14"><path d={network.icon.path} /></svg>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </section>
    <section aria-labelledby="footer-about-heading" class="flex flex-col gap-4 border-t border-(--border) pt-8 md:border-t-0 md:pt-0">
      <h2 id="footer-about-heading" class="text-xl font-bold">{shelter.name}</h2>
      <dl class="flex flex-col gap-5 text-pretty [&_dd]:mt-1">
        {shelter.city && <div><dt class="text-sm text-(--muted)">{t("cityLabel")}</dt><dd>{shelter.city}</dd></div>}
        <div><dt class="text-sm text-(--muted)">{t("addressLabel")}</dt><dd>{shelter.address || t("addressByAppointment")}</dd></div>
        {shelter.contact_hours && <div><dt class="text-sm text-(--muted)">{t("hoursLabel")}</dt><dd lang={hoursLanguage}>{shelter.contact_hours}</dd></div>}
        {shelter.founded_year !== null && <div><dt class="text-sm text-(--muted)">{t("foundedLabel")}</dt><dd>{shelter.founded_year}</dd></div>}
        {shelter.legal_info && <div><dt class="text-sm text-(--muted)">{t("legalLabel")}</dt><dd lang={legalInfoLanguage}>{shelter.legal_info}</dd></div>}
      </dl>
    </section>
    <nav aria-labelledby="footer-links-heading" class="flex flex-col gap-3 border-t border-(--border) pt-8 md:border-t-0 md:pt-0">
      <p id="footer-links-heading" class="text-xl font-bold">{t("linksLabel")}</p>
      <ul class="grid grid-cols-2 gap-x-4 md:flex md:flex-col">
        {links.map((link) => (
          <li><a href={`/${locale}${link.href}`} class="inline-block py-3 font-semibold text-(--accent) hover:underline">{link.label}</a></li>
        ))}
        <li><a href={`/${locale}/privacy`} class="inline-block py-3 font-semibold text-(--accent) hover:underline">{t("privacyLink")}</a></li>
      </ul>
    </nav>
  </div>
  {showTranslationNote && <p class="mx-auto w-full max-w-5xl px-4 pb-8 text-sm text-(--muted)">{t("translationNote")}</p>}
</footer>
